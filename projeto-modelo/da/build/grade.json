      "token": "tratamento.grade.lut + intensidade_lut",
      "filtro": "lut3d (+ split/blend)",
      "regra": "intensidade 1 → lut3d direto; entre 0 e 1 → split, lut3d num ramo e blend normal com all_opacity = intensidade"
    },
    {
      "token": "tratamento.duotone",
      "filtro": "colorchannelmixer + lutrgb (+ split/blend)",
      "regra": "luma BT.709 nos três canais e rampa linear sombra→luz por canal; mistura < 1 usa split/blend"
    },
    {
      "token": "tratamento.desfoque",
      "filtro": "gblur",
      "regra": "sigma = fração × lado menor do quadro (px)"
    },
