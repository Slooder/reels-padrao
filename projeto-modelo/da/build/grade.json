      "filtro": "unsharp",
      "regra": "unsharp 5x5 só na luma, la = nitidez"
    },
    {
      "token": "tratamento.vinheta",
      "filtro": "vignette",
      "regra": "vignette=angle=<angulo em rad>"
    },
    {
      "token": "tratamento.grao",
      "filtro": "noise",
      "regra": "ruído uniforme só na luma: noise=c0s=<intensidade>:c0f=t+u (temporal) ou c0f=u (fixo)"
